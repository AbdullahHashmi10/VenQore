<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VenQore Verification Center — One Dashboard</title>
<style>
  :root {
    --bg:#0b0d12; --panel:#151922; --panel2:#1c2230; --ink:#e6eaf2; --muted:#8a93a6;
    --line:#242c3a; --t1:#22c55e; --t2:#eab308; --t3:#60a5fa; --red:#ef4444; --green:#22c55e;
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
    font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
  header { padding:20px 28px; border-bottom:1px solid var(--line); display:flex;
    align-items:center; justify-content:space-between; }
  h1 { font-size:18px; margin:0; letter-spacing:.2px; }
  .sub { color:var(--muted); font-size:12px; }
  main { padding:24px 28px; max-width:1200px; margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; }
  .card { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:18px; }
  .card h2 { font-size:12px; text-transform:uppercase; letter-spacing:.6px; color:var(--muted);
    margin:0 0 10px; }
  .big { font-size:34px; font-weight:700; }
  .pill { display:inline-block; padding:2px 10px; border-radius:999px; font-size:12px; font-weight:600; }
  .pill.green { background:rgba(34,197,94,.15); color:var(--green); }
  .pill.red { background:rgba(239,68,68,.15); color:var(--red); }
  .pill.pending { background:rgba(138,147,166,.15); color:var(--muted); }
  table { width:100%; border-collapse:collapse; margin-top:8px; }
  th,td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); font-size:13px; }
  th { color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.5px; }
  .tier { font-weight:700; }
  .tier.T1{color:var(--t1)} .tier.T2{color:var(--t2)} .tier.T3{color:var(--t3)}
  .bar { height:8px; border-radius:4px; background:var(--panel2); overflow:hidden; display:flex; }
  .bar > span { display:block; height:100%; }
  .muted { color:var(--muted); }
  .section { margin-top:28px; }
  .section h2 { font-size:13px; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); }
  code { background:var(--panel2); padding:1px 6px; border-radius:4px; font-size:12px; }
  .dim { display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--line); }
  .err { color:var(--red); }
  .btn { background:var(--t1); color:var(--bg); border:none; padding:8px 16px; border-radius:6px; font-weight:600; cursor:pointer; font-size:13px; transition:background 0.2s; margin-left:16px; }
  .btn:hover { background:#4ade80; }
  .btn:disabled { background:var(--panel2); color:var(--muted); cursor:not-allowed; }
  footer { padding:20px 28px; color:var(--muted); font-size:12px; border-top:1px solid var(--line); }
</style>
</head>
<body>
<header>
  <div>
    <h1>VenQore Verification Center — One Dashboard</h1>
    <div class="sub">Registry · Live Run · Trust (measured) · Oracle tiers</div>
  </div>
  <div style="display:flex; align-items:center;">
    <div class="sub" id="generated">loading…</div>
    <button class="btn" id="runBtn" onclick="runTests()">Run Tests</button>
  </div>
</header>
<main id="root">
  <div class="card"><p class="muted" id="status">Loading dashboard-data.json…</p></div>
</main>
<footer>
  Data: <code>Tester/VerificationCenter/dashboard-data.json</code> — regenerate with
  <code>php artisan verify:dashboard-data</code>. The score is <strong>measured over landed
  dimensions only</strong>; pending phases are excluded, never assumed green.
</footer>
<script>
async function load() {
  let data;
  try {
    const r = await fetch('dashboard-data.json', {cache:'no-store'});
    if (!r.ok) throw new Error('HTTP '+r.status);
    data = await r.json();
  } catch (e) {
    document.getElementById('status').innerHTML =
      '<span class="err">Could not load dashboard-data.json ('+e.message+').</span><br>'+
      'Run <code>php artisan verify:dashboard-data</code> first, then serve this folder '+
      '(the file:// protocol blocks fetch — use the launcher or any static server).';
    return;
  }
  render(data);
}

function pill(state){
  if(state===true) return '<span class="pill green">GREEN</span>';
  if(state===false) return '<span class="pill red">RED</span>';
  return '<span class="pill pending">NO RUN YET</span>';
}

function render(d){
  document.getElementById('generated').textContent = 'generated ' + (d.generated_at||'');
  const reg = d.registry||{}, trust = d.trust||{}, run = d.latest_run||null;
  const tf = reg.tier_files||{}, tt = reg.tier_test_methods||{};
  const totalTests = (tt.T1||0)+(tt.T2||0)+(tt.T3||0);
  const w = x => totalTests? Math.round((x/totalTests)*100):0;

  const score = trust.measured_score;
  const scoreStr = (score==null?'—':score.toFixed(2)) + ' <span class="muted" style="font-size:16px">/ 10</span>';

  let dimsRows = '';
  for (const [k,v] of Object.entries(trust.dimensions||{})) {
    const h = v.health;
    const st = h==null?'<span class="pill pending">pending</span>'
             : h>=1?'<span class="pill green">'+(h*100).toFixed(0)+'%</span>'
             : '<span class="pill red">'+(h*100).toFixed(0)+'%</span>';
    dimsRows += '<div class="dim"><span>'+k.replace(/_/g,' ')+'<br><span class="muted" style="font-size:11px">'+(v.evidence||'')+'</span></span>'+st+'</div>';
  }

  document.getElementById('root').innerHTML = `
    <div class="grid">
      <div class="card">
        <h2>Latest Run</h2>
        <div>${pill(run?run.green:null)}</div>
        <p class="muted" style="margin:8px 0 0">${run? ('total '+(run.total||'?')+' · '+(run.finished_at||'')) : 'No Run Ledger record yet. Run verify:all.'}</p>
      </div>
      <div class="card">
        <h2>Measured Trust</h2>
        <div class="big">${scoreStr}</div>
        <p class="muted" style="margin:6px 0 0">over ${((trust.weight_measured||0)*100).toFixed(0)}% of weight · projected after B: ${trust.projected_after_B ?? '—'}</p>
      </div>
      <div class="card">
        <h2>Registry</h2>
        <div class="big">${reg.phpunit_test_methods ?? '—'}</div>
        <p class="muted" style="margin:6px 0 0">${reg.suites ?? '?'} suites · ${reg.verification_sources ?? '?'} sweep sources</p>
      </div>
      <div class="card">
        <h2>Oracle Tiers (test methods)</h2>
        <div class="bar">
          <span style="width:${w(tt.T1)}%;background:var(--t1)"></span>
          <span style="width:${w(tt.T2)}%;background:var(--t2)"></span>
          <span style="width:${w(tt.T3)}%;background:var(--t3)"></span>
        </div>
        <p class="muted" style="margin:8px 0 0">
          <span class="tier T1">■ T1 ${tt.T1||0}</span> &nbsp;
          <span class="tier T2">■ T2 ${tt.T2||0}</span> &nbsp;
          <span class="tier T3">■ T3 ${tt.T3||0}</span>
        </p>
      </div>
    </div>

    <div class="section">
      <h2>Trust dimensions (10/10 definition, §19)</h2>
      <div class="card">${dimsRows||'<span class="muted">no trust model</span>'}</div>
    </div>

    <div class="section">
      <h2>How to read the tiers</h2>
      <div class="card">
        <p><span class="tier T1">T1 truth-anchored</span> — correct comes from an independent oracle (hand-derived spec + derivation-checked calculator, or a pure ledger invariant). Disagreement = real bug.</p>
        <p><span class="tier T2">T2 consis