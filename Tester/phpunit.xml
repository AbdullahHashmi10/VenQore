<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         stopOnFailure="false"
>
    <testsuites>
        <testsuite name="Smoke">
            <directory>tests/Feature/Smoke</directory>
        </testsuite>

        <!--
          ROUTING - Run before every deployment.
          Catches Ziggy route-not-found errors before users do.
          Use testsuite name: Routing
        -->
        <testsuite name="Routing">
            <file>tests/Feature/ZiggyRouteIntegrityTest.php</file>
            <file>tests/Feature/RouteParameterRegressionTest.php</file>
            <file>tests/Feature/OwnersDailyPulseTest.php</file>
        </testsuite>

        <testsuite name="Critical">
            <directory>tests/Feature/Module01</directory>
            <directory>tests/Feature/Module02</directory>
            <directory>tests/Feature/Module03</directory>
            <directory>tests/Feature/Module04</directory>
            <directory>tests/Feature/Module05</directory>
            <directory>tests/Feature/Module10</directory>
            <directory>tests/Feature/Module11</directory>
            <directory>tests/Feature/Module12</directory>
            <!-- Route integrity tests included in Critical runs -->
            <file>tests/Feature/ZiggyRouteIntegrityTest.php</file>
            <file>tests/Feature/RouteParameterRegressionTest.php</file>
            <file>tests/Feature/OwnersDailyPulseTest.php</file>
        </testsuite>
        <testsuite name="High">
            <directory>tests/Feature/Module06</directory>
            <directory>tests/Feature/Module07</directory>
            <directory>tests/Feature/Module08</directory>
            <directory>tests/Feature/Module09</directory>
            <directory>tests/Feature/Module13</directory>
            <directory>tests/Feature/Module14</directory>
            <directory>tests/Feature/Module15</directory>
            <directory>tests/Feature/Module16</directory>
            <directory>tests/Feature/Module17</directory>
            <directory>tests/Feature/Module18</directory>
            <directory>tests/Feature/Module19</directory>
            <directory>tests/Feature/Module20</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../app</directory>
        </include>
    </source>
    <php>
        <env name="APP_NAME"                  value="VenQore Testing"/>
        <env name="APP_ENV"                   value="testing"/>
        <env name="APP_KEY"                   value="base64:2yEI71seB86Bj2BjZitdmFfCsRVzPqp56iV6TCJ5wx0="/>
        <env name="APP_DEBUG"                 value="true"/>
        <env name="APP_MAINTENANCE_DRIVER"    value="file"/>
        <env name="BCRYPT_ROUNDS"             value="4"/>
        <env name="BROADCAST_CONNECTION"      value="null"/>
        <!-- Production smoke tests run against REAL MySQL — not SQLite.
             DB credentials come from Tester/.env.testing (amd_pos_test). -->
        <env name="DB_CONNECTION"             value="mysql"/>
        <env name="DB_HOST"                   value="127.0.0.1"/>
        <env name="DB_PORT"                   value="3306"/>
        <env name="DB_DATABASE"               value="amd_pos_test"/>
        <env name="DB_USERNAME"               value="root"/>
        <env name="DB_PASSWORD"               value=""/>
        <!-- SMOKE_DB_DATABASE: Override only for smoke tests that connect to a specific DB.
             Set to the local test DB name. On live server, set this to 'venqore_pos'. -->
        <env name="SMOKE_DB_DATABASE"         value="amd_pos_test"/>
        <env name="QUEUE_CONNECTION"          value="sync"/>
        <env name="MAIL_MAILER"               value="array"/>
        <!-- WooCommerce keys intentionally empty — regression test for isolation bug -->
        <env name="WOOCOMMERCE_KEY"           value=""/>
        <env name="WOOCOMMERCE_SECRET"        value=""/>
        <env name="WOOCOMMERCE_URL"           value=""/>
        <env name="PULSE_ENABLED"             value="false"/>
        <env name="TELESCOPE_ENABLED"         value="false"/>
        <env name="NIGHTWATCH_ENABLED"        value="false"/>
        <env name="HORIZON_ENABLED"           value="false"/>
    </php>
</phpunit>
