# ============================================================
#  VenQore Root Git Ignore Rules (For Restructured Repo)
# ============================================================

# Core Laravel ignores
/app-code/main-app/storage/framework/cache/data/*
/app-code/main-app/storage/framework/sessions/*
/app-code/main-app/storage/framework/testing/*
/app-code/main-app/storage/framework/views/*
/app-code/main-app/storage/app/public/*
/app-code/main-app/storage/logs/*
!/app-code/main-app/storage/framework/cache/data/.gitignore
!/app-code/main-app/storage/framework/sessions/.gitignore
!/app-code/main-app/storage/framework/testing/.gitignore
!/app-code/main-app/storage/framework/views/.gitignore
!/app-code/main-app/storage/app/public/.gitignore
!/app-code/main-app/storage/logs/.gitignore

# Dependency directories (Ignore everywhere)
node_modules/
vendor/

# Environment files
.env
.env.backup
.env.production
.env.testing
/app-code/main-app/.env
/app-code/main-app/.env.testing

# Prepared environment files
deploy/env/*.env
/app-code/main-app/deploy/env/*.env

# Logs and system files
*.log
.DS_Store
Thumbs.db

# Windows App build output & node_modules
/app-code/windows-app/node_modules/
/app-code/windows-app/dist/

# Mobile App build output & tooling
/app-code/mobile-app/.dart_tool/
/app-code/mobile-app/build/
/app-code/mobile-app/.flutter-plugins
/app-code/mobile-app/.flutter-plugins-dependencies
/app-code/mobile-app/android/.gradle/
/app-code/mobile-app/android/local.properties

# Extracted builds & packages in builds/ folder
builds/AMD_POS_Update_v*.zip
builds/release_hosting_VenQore_*.zip
builds/*.exe
builds/contacts.zip
builds/upload_v3.zip
builds/venqore-production.zip
builds/venqore-sync.zip
builds/AMD_POS_Updater_Hotfix.zip
builds/release_hosting_v2.0.0.zip

# Scratch files
/scratch/
/app-code/main-app/scratch/

# Test dashboard configs
/app-code/main-app/tests/dashboard/last-results.json
/app-code/main-app/tests/logs/

# Build assets
/app-code/main-app/public/build
.phpunit.result.cache
bootstrap/ssr/
