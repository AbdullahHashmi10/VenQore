APP_NAME="VenQore POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# DATABASE CONFIGURATION
# ============================================
# IMPORTANT: Update these with your MySQL database details
# On shared hosting (cPanel), your database name and username
# are usually prefixed with your cPanel username, like:
# username_venqorepos and username_dbuser
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=venqore_pos
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# SESSION & CACHE (Safe defaults for shared hosting)
# ============================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=venqore_pos_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MAIL CONFIGURATION (Optional)
# ============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# GOOGLE DRIVE BACKUPS CONFIGURATION
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ============================================
# LEMON SQUEEZY BILLING CONFIGURATION
# ============================================
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_SIGNING_SECRET=

# Monthly Variant IDs
LEMON_SQUEEZY_STARTER_VARIANT_ID=
LEMON_SQUEEZY_GROWTH_VARIANT_ID=
LEMON_SQUEEZY_BUSINESS_VARIANT_ID=

# Annual Variant IDs
LEMON_SQUEEZY_STARTER_ANNUAL_VARIANT_ID=
LEMON_SQUEEZY_GROWTH_ANNUAL_VARIANT_ID=
LEMON_SQUEEZY_BUSINESS_ANNUAL_VARIANT_ID=

# LTD Variant IDs
LEMON_SQUEEZY_STARTER_LTD_VARIANT_ID=
LEMON_SQUEEZY_GROWTH_LTD_VARIANT_ID=
LEMON_SQUEEZY_BUSINESS_LTD_VARIANT_ID=

# Add-On Variant IDs
LEMON_SQUEEZY_WOOCOMMERCE_ADDON_ID=
LEMON_SQUEEZY_AMAZON_ADDON_ID=
LEMON_SQUEEZY_EBAY_ADDON_ID=
LEMON_SQUEEZY_TIKTOK_ADDON_ID=
LEMON_SQUEEZY_AI_STARTER_ADDON_ID=
LEMON_SQUEEZY_AI_LITE_ADDON_ID=
LEMON_SQUEEZY_AI_PRO_ADDON_ID=
LEMON_SQUEEZY_AI_ULTIMATE_ADDON_ID=
LEMON_SQUEEZY_AI_BYOK_ADDON_ID=

LEMON_SQUEEZY_UPLOAD_SERVICE_VARIANT_ID=

# Checkout URLs
LEMON_SQUEEZY_STARTER_CHECKOUT_URL=
LEMON_SQUEEZY_GROWTH_CHECKOUT_URL=
LEMON_SQUEEZY_BUSINESS_CHECKOUT_URL=

# PKR variant IDs — optional. When set, PKR checkouts are generated through the
# Lemon Squeezy API (prefilled + branded) instead of the static PKR store URLs.
LEMON_SQUEEZY_STARTER_PKR_VARIANT_ID=
LEMON_SQUEEZY_GROWTH_PKR_VARIANT_ID=
LEMON_SQUEEZY_BUSINESS_PKR_VARIANT_ID=
LEMON_SQUEEZY_STARTER_ANNUAL_PKR_VARIANT_ID=
LEMON_SQUEEZY_GROWTH_ANNUAL_PKR_VARIANT_ID=
LEMON_SQUEEZY_BUSINESS_ANNUAL_PKR_VARIANT_ID=

# Checkout appearance — themes the in-app checkout overlay.
# (embed is always on; it is what keeps the customer inside VenQore.)
LEMON_SQUEEZY_CHECKOUT_DARK=true
LEMON_SQUEEZY_CHECKOUT_LOGO=true
LEMON_SQUEEZY_CHECKOUT_MEDIA=false
LEMON_SQUEEZY_CHECKOUT_DESC=false
LEMON_SQUEEZY_CHECKOUT_DISCOUNT=true
LEMON_SQUEEZY_CHECKOUT_BUTTON_COLOR="#7C3AED"

VITE_APP_NAME="${APP_NAME}"

# ── Error Monitoring / APM (Sentry) — L020 / L040 ───────────────────────────
# Leave blank to keep monitoring OFF. Set to your Sentry project DSN to enable
# real-time exception capture (backend + frontend) and route the cron/backup/
# reconciliation failure alerts through the same project.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
