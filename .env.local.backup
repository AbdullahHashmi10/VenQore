# ============================================================================
# VenQore POS — LEMON SQUEEZY **TEST MODE**
# ----------------------------------------------------------------------------
# Upload as `.env` on venqore.com while you verify that paying correctly
# allots plans, add-ons and limits. No real money moves in this mode.
#
# AFTER UPLOADING:
#   php artisan config:clear
#   (do NOT run config:cache until you've confirmed the values are live)
#
# THE ONE THING THAT MUST MATCH:
#   LEMON_SQUEEZY_SIGNING_SECRET below must be byte-for-byte identical to the
#   secret on your TEST-MODE webhook in Lemon Squeezy →
#   Settings → Webhooks → (test mode toggle ON) → your venqore.com endpoint.
#   If they differ, every webhook is rejected 401 and nothing is ever allotted.
#
# Webhook URL to register:  https://venqore.com/api/webhooks/lemon-squeezy
# Events to enable: order_created, subscription_created, subscription_updated,
#                   subscription_cancelled, subscription_expired,
#                   subscription_payment_failed, subscription_payment_recovered
# ============================================================================

APP_NAME="VenQore POS"
APP_ENV=production
APP_KEY=base64:M3JaWVo2VncwT3pPTUFxZnFEWlVBSEIzWHk0dmZPRmk=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://venqore.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Verbose on purpose while testing — you want to SEE the webhook arrive.
# Tail with: tail -f storage/logs/laravel.log | grep -i "lemon\|Provision"
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u186374501_VenQore
DB_USERNAME=u186374501_VenQore
DB_PASSWORD='~o7V;E$^OpL'

# ============================================
# SESSION & CACHE
# ============================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=file
CACHE_PREFIX=venqore_pos_
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Kept as `sync` deliberately: provisioning then runs inline inside the webhook
# request, so a failure shows up immediately in the log instead of sitting
# silently in a jobs table with no worker running. Move to `database` + a cron
# worker only once you have the worker actually running (see production.env).
QUEUE_CONNECTION=sync

# ============================================
# MAIL
# ============================================
# `log` means the welcome email — which contains the generated password for
# brand-new owners — goes to storage/logs instead of the customer. Fine while
# testing plan allotment against an EXISTING account. Switch to real SMTP
# before testing the new-customer signup path end to end.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@venqore.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# GOOGLE AUTHENTICATION
# ============================================
GOOGLE_CLIENT_ID="982887079806-j1d270ao3j6doljik7qd3cmmevu9u0ku.apps.googleusercontent.com"
