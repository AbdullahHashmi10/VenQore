# ── Checkout appearance (in-app overlay) ──
LEMON_SQUEEZY_CHECKOUT_DARK=true
LEMON_SQUEEZY_CHECKOUT_LOGO=true
LEMON_SQUEEZY_CHECKOUT_MEDIA=false
LEMON_SQUEEZY_CHECKOUT_DESC=false
LEMON_SQUEEZY_CHECKOUT_DISCOUNT=true
LEMON_SQUEEZY_CHECKOUT_BUTTON_COLOR="#7C3AED"
