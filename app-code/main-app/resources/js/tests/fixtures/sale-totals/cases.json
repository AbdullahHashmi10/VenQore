{
  "_about": "Hand-computed expectations for calculation contract v2. Run by BOTH resources/js/tests/saleTotalsParity.test.js and tests/Unit/SaleTotalsParityTest.php. Expected values were worked by hand from the policy in Sell/core/saleTotals.js \u2014 never generated by running either implementation. Amounts are currency strings.",
  "cases": [
    {
      "name": "7725 at a 12.5% bill discount rounds the discount once",
      "input": {
        "lines": [
          {
            "unit_price": "7725",
            "qty": "1"
          }
        ],
        "bill_discount": {
          "type": "percentage",
          "value": "12.5"
        }
      },
      "expect": {
        "bill_discount": "965.63",
        "taxable": "6759.37",
        "invoice": "6759.37",
        "round_off": "0.00"
      }
    },
    {
      "name": "weighed line quantizes once, half-up",
      "input": {
        "lines": [
          {
            "unit_price": "399",
            "qty": "1.235"
          }
        ]
      },
      "expect": {
        "subtotal_gross": "492.77",
        "invoice": "492.77"
      }
    },
    {
      "name": "two small taxable lines are taxed per line",
      "input": {
        "lines": [
          {
            "unit_price": "0.05",
            "qty": "1"
          },
          {
            "unit_price": "0.05",
            "qty": "1"
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "10"
        }
      },
      "expect": {
        "tax": "0.02",
        "invoice": "0.12",
        "lines": [
          {
            "tax": "0.01"
          },
          {
            "tax": "0.01"
          }
        ]
      }
    },
    {
      "name": "values below, at and above half a paisa",
      "input": {
        "lines": [
          {
            "unit_price": "0.005",
            "qty": "1"
          },
          {
            "unit_price": "0.004999",
            "qty": "1"
          },
          {
            "unit_price": "100.005",
            "qty": "1"
          }
        ]
      },
      "expect": {
        "lines": [
          {
            "gross": "0.01"
          },
          {
            "gross": "0.00"
          },
          {
            "gross": "100.01"
          }
        ],
        "invoice": "100.02"
      }
    },
    {
      "name": "one paisa bill discount over three equal lines goes to the first",
      "input": {
        "lines": [
          {
            "unit_price": "1",
            "qty": "1"
          },
          {
            "unit_price": "1",
            "qty": "1"
          },
          {
            "unit_price": "1",
            "qty": "1"
          }
        ],
        "bill_discount": {
          "type": "fixed",
          "value": "0.01"
        }
      },
      "expect": {
        "lines": [
          {
            "bill_share": "0.01",
            "base": "0.99"
          },
          {
            "bill_share": "0.00",
            "base": "1.00"
          },
          {
            "bill_share": "0.00",
            "base": "1.00"
          }
        ],
        "invoice": "2.99"
      }
    },
    {
      "name": "largest remainder allocation conserves the discount",
      "input": {
        "lines": [
          {
            "unit_price": "1",
            "qty": "1"
          },
          {
            "unit_price": "2",
            "qty": "1"
          },
          {
            "unit_price": "3",
            "qty": "1"
          }
        ],
        "bill_discount": {
          "type": "fixed",
          "value": "1"
        }
      },
      "expect": {
        "lines": [
          {
            "bill_share": "0.17"
          },
          {
            "bill_share": "0.33"
          },
          {
            "bill_share": "0.50"
          }
        ],
        "taxable": "5.00",
        "invoice": "5.00"
      }
    },
    {
      "name": "inclusive 18% splits the price",
      "input": {
        "lines": [
          {
            "unit_price": "118",
            "qty": "2"
          },
          {
            "unit_price": "59",
            "qty": "3"
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": true,
          "default_rate": "18"
        }
      },
      "expect": {
        "tax": "63.00",
        "revenue": "350.00",
        "invoice": "413.00",
        "lines": [
          {
            "tax": "36.00",
            "revenue": "200.00"
          },
          {
            "tax": "27.00",
            "revenue": "150.00"
          }
        ]
      }
    },
    {
      "name": "exclusive 18% after a 5% bill discount",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "2"
          },
          {
            "unit_price": "50",
            "qty": "3"
          }
        ],
        "bill_discount": {
          "type": "percentage",
          "value": "5"
        },
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "18"
        }
      },
      "expect": {
        "bill_discount": "17.50",
        "lines": [
          {
            "bill_share": "10.00",
            "tax": "34.20"
          },
          {
            "bill_share": "7.50",
            "tax": "25.65"
          }
        ],
        "tax": "59.85",
        "invoice": "392.35"
      }
    },
    {
      "name": "whole-rupee bill rounding is an explicit round-off",
      "input": {
        "lines": [
          {
            "unit_price": "33.33",
            "qty": "3"
          },
          {
            "unit_price": "12.49",
            "qty": "7"
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "17"
        },
        "bill_rounding": {
          "apply": true,
          "setting": "0"
        }
      },
      "expect": {
        "tax": "31.86",
        "components": "219.28",
        "invoice": "219.00",
        "round_off": "-0.28"
      }
    },
    {
      "name": "bill rounding switched off keeps paisa",
      "input": {
        "lines": [
          {
            "unit_price": "33.33",
            "qty": "3"
          }
        ],
        "bill_rounding": {
          "apply": false,
          "setting": "0"
        }
      },
      "expect": {
        "invoice": "99.99",
        "round_off": "0.00"
      }
    },
    {
      "name": "rounding to tens, half-up",
      "input": {
        "lines": [
          {
            "unit_price": "1235",
            "qty": "1"
          },
          {
            "unit_price": "1234.56",
            "qty": "1"
          }
        ],
        "bill_rounding": {
          "apply": true,
          "setting": "-1"
        }
      },
      "expect": {
        "components": "2469.56",
        "invoice": "2470.00",
        "round_off": "0.44"
      }
    },
    {
      "name": "each typed charge is counted once",
      "input": {
        "lines": [
          {
            "unit_price": "450",
            "qty": "2"
          }
        ],
        "charges": {
          "delivery": "120",
          "extra": "30",
          "service": "10",
          "tip": "50"
        }
      },
      "expect": {
        "delivery": "120.00",
        "extra": "30.00",
        "service": "10.00",
        "tip": "50.00",
        "charges": "210.00",
        "invoice": "1110.00"
      }
    },
    {
      "name": "service charge percentage is on the discounted base",
      "input": {
        "lines": [
          {
            "unit_price": "1800",
            "qty": "1"
          },
          {
            "unit_price": "40",
            "qty": "4"
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "16"
        },
        "charges": {
          "service_pct": "10",
          "tip": "150"
        }
      },
      "expect": {
        "tax": "313.60",
        "service": "196.00",
        "invoice": "2619.60"
      }
    },
    {
      "name": "free quantity is in gross and discount, not in net",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "2",
            "free_qty": "1"
          },
          {
            "unit_price": "50",
            "qty": "3"
          }
        ]
      },
      "expect": {
        "subtotal_gross": "450.00",
        "free_value": "100.00",
        "sum_net": "350.00",
        "invoice": "350.00"
      }
    },
    {
      "name": "line discount reduces the net",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "2",
            "discount": "20"
          },
          {
            "unit_price": "50",
            "qty": "3"
          }
        ]
      },
      "expect": {
        "item_discounts": "20.00",
        "sum_net": "330.00",
        "invoice": "330.00"
      }
    },
    {
      "name": "fixed per-line tax",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "1",
            "tax_type": "fixed",
            "tax_rate": "5"
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "0"
        }
      },
      "expect": {
        "tax": "5.00",
        "invoice": "105.00"
      }
    },
    {
      "name": "a product's own rate beats the sale rate, including zero",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "1",
            "tax_rate": "0"
          },
          {
            "unit_price": "100",
            "qty": "1",
            "tax_rate": null
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "10"
        }
      },
      "expect": {
        "lines": [
          {
            "tax": "0.00"
          },
          {
            "tax": "10.00"
          }
        ],
        "invoice": "210.00"
      }
    },
    {
      "name": "tax switched off ignores product rates",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "1",
            "tax_rate": "17"
          }
        ],
        "tax": {
          "enabled": false,
          "inclusive": false,
          "default_rate": "17"
        }
      },
      "expect": {
        "tax": "0.00",
        "invoice": "100.00"
      }
    },
    {
      "name": "zero invoice",
      "input": {
        "lines": [
          {
            "unit_price": "0",
            "qty": "1"
          }
        ]
      },
      "expect": {
        "invoice": "0.00"
      }
    },
    {
      "name": "large valid amount",
      "input": {
        "lines": [
          {
            "unit_price": "9999999.99",
            "qty": "1000"
          }
        ]
      },
      "expect": {
        "invoice": "9999999990.00"
      }
    },
    {
      "name": "bill discount larger than the sale is refused",
      "input": {
        "lines": [
          {
            "unit_price": "100",
            "qty": "1"
          }
        ],
        "bill_discount": {
          "type": "fixed",
          "value": "100.01"
        }
      },
      "error": "excessive_discount"
    },
    {
      "name": "line discount larger than the line is refused",
      "input": {
        "lines": [
          {
            "unit_price": "10",
            "qty": "1",
            "discount": "10.01"
          }
        ]
      },
      "error": "excessive_discount"
    },
    {
      "name": "thousands separator is ambiguous",
      "input": {
        "lines": [
          {
            "unit_price": "1,000",
            "qty": "1"
          }
        ]
      },
      "error": "invalid_amount"
    },
    {
      "name": "more than six decimals is refused",
      "input": {
        "lines": [
          {
            "unit_price": "0.0000001",
            "qty": "1"
          }
        ]
      },
      "error": "invalid_amount"
    },
    {
      "name": "not a number",
      "input": {
        "lines": [
          {
            "unit_price": "abc",
            "qty": "1"
          }
        ]
      },
      "error": "invalid_amount"
    },
    {
      "name": "negative price",
      "input": {
        "lines": [
          {
            "unit_price": "-1",
            "qty": "1"
          }
        ]
      },
      "error": "negative_amount"
    },
    {
      "name": "negative charge",
      "input": {
        "lines": [
          {
            "unit_price": "1",
            "qty": "1"
          }
        ],
        "charges": {
          "delivery": "-5"
        }
      },
      "error": "negative_amount"
    },
    {
      "name": "overflow",
      "input": {
        "lines": [
          {
            "unit_price": "999999999999",
            "qty": "99999"
          }
        ]
      },
      "error": "overflow"
    },
    {
      "name": "line discount percentage is quantized once on the line gross",
      "input": {
        "lines": [
          {
            "unit_price": "333.33",
            "qty": "3",
