          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "0"
        }
      },
      "expect": {
        "lines": [
          {
            "gross": "999.99",
            "discount": "75.00",
            "net": "924.99"
          }
        ],
        "invoice": "924.99"
      }
    },
    {
      "name": "line discount percentage with per-line tax (V3 engine shape)",
      "input": {
        "lines": [
          {
            "unit_price": "199.99",
            "qty": "3",
            "discount_percent": "12.5",
            "tax_rate": "17"
          },
          {
            "unit_price": "0.05",
            "qty": "1",
            "tax_rate": "10"
          }
        ],
        "tax": {
          "enabled": true,
          "inclusive": false,
          "default_rate": "0"
        }
      },
      "expect": {
        "lines": [
          {
            "gross": "599.97",
            "discount": "75.00",
            "net": "524.97",
            "tax": "89.24"
          },
          {
            "tax": "0.01"
          }
        ],
        "tax": "89.25",
        "invoice": "614.27"
      }
    },
    {
      "name": "a 100% line discount leaves a zero line",
      "input": {
        "lines": [
          {
            "unit_price": "10",
            "qty": "1",
            "discount_percent": "100"
          }
        ]
      },
      "expect": {
        "invoice": "0.00"
      }
    },
    {
      "name": "over 100% line discount is refused",
      "input": {
        "lines": [
          {
            "unit_price": "10",
            "qty": "1",
            "discount_percent": "100.01"
          }
        ]
      },
      "error": "excessive_discount"
    },
    {
      "name": "amount and percentage together are refused",
      "input": {
        "lines": [
          {
            "unit_price": "10",
            "qty": "1",
            "discount": "1",
            "discount_percent": "5"
          }
        ]
      },
      "error": "invalid_discount"
    }
  ]
}
