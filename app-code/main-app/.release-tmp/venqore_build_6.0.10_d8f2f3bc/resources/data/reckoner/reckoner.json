{
  "streams": {
    "ledger.journal": {
      "key": "ledger.journal",
      "name": "Journal postings",
      "what": "Every debit and credit the accounting engine writes. The spine — most money cards trace back here.",
      "cards": 73
    },
    "ledger.accounts": {
      "key": "ledger.accounts",
      "name": "Account balances",
      "what": "Running balance per chart-of-accounts node, per period.",
      "cards": 67
    },
    "sales.headers": {
      "key": "sales.headers",
      "name": "Sale documents",
      "what": "One row per sale, invoice, or counter ticket: date, party, totals, payment state.",
      "cards": 148
    },
    "sales.lines": {
      "key": "sales.lines",
      "name": "Sale lines",
      "what": "One row per line item: product, qty, price, cost at time of sale, discount, tax.",
      "cards": 78
    },
    "purchase.headers": {
      "key": "purchase.headers",
      "name": "Purchase documents",
      "what": "One row per supplier bill: date, supplier, totals, payment state.",
      "cards": 36
    },
    "purchase.lines": {
      "key": "purchase.lines",
      "name": "Purchase lines",
      "what": "One row per bought line: item, qty, cost, landed additions, tax.",
      "cards": 25
    },
    "stock.movements": {
      "key": "stock.movements",
      "name": "Stock movements",
      "what": "Every in, out, transfer, adjustment and write-off, with qty and valuation.",
      "cards": 54
    },
    "stock.positions": {
      "key": "stock.positions",
      "name": "Stock positions",
      "what": "Current qty and value per item per location per batch, plus reorder points.",
      "cards": 78
    },
    "party.balances": {
      "key": "party.balances",
      "name": "Party balances",
      "what": "Running receivable and payable per customer and supplier, with age.",
      "cards": 84
    },
    "payment.entries": {
      "key": "payment.entries",
      "name": "Payments",
      "what": "Every receipt and payout with method, instrument and allocation.",
      "cards": 76
    },
    "expense.entries": {
      "key": "expense.entries",
      "name": "Expenses",
      "what": "Every expense with category, payment method, and paid / unpaid state.",
      "cards": 41
    },
    "tax.entries": {
      "key": "tax.entries",
      "name": "Tax entries",
      "what": "Output and input tax per document, per rate band.",
      "cards": 8
    },
    "production.entries": {
      "key": "production.entries",
      "name": "Production",
      "what": "Runs, consumption, output, yield and wastage.",
      "cards": 8
    },
    "attendance.entries": {
      "key": "attendance.entries",
      "name": "Attendance",
      "what": "Shifts, hours, presence and per-staff sale attribution.",
      "cards": 8
    },
    "doc.status": {
      "key": "doc.status",
      "name": "Document states",
      "what": "Open / fulfilled / overdue / expired counts for orders, quotes, POs and transfers.",
      "cards": 81
    },
    "master.registry": {
      "key": "master.registry",
      "name": "Master records",
      "what": "Counts and completeness of products, parties, accounts, assets, staff.",
      "cards": 96
    }
  },
  "coreStreams": [
    "ledger.journal",
    "ledger.accounts",
    "party.balances",
    "payment.entries",
    "sales.headers",
    "expense.entries"
  ],
  "envelope": [
    {
      "field": "status",
      "type": "ok | empty | locked | stale | error",
      "note": "Never absent. `empty` means the query ran and found nothing — a new tenant, not a bug. `locked` means the owning module is off. A blank card is currently indistinguishable from all five; that is the bug."
    },
    {
      "field": "value",
      "type": "number | null",
      "note": "The headline figure. Null only when status is not ok."
    },
    {
      "field": "unit",
      "type": "currency | count | percent | days | ratio",
      "note": "Drives formatting. Wrong units are the second most reported 'wrong number'."
    },
    {
      "field": "precision",
      "type": "integer",
      "note": "Decimal places. Fixed per card, never inferred from the value."
    },
    {
      "field": "delta",
      "type": "{value, pct, basis} | null",
      "note": "Change against the comparable previous period."
    },
    {
      "field": "series",
      "type": "[{t, v}] | null",
      "note": "Present for trend cards. Daily granularity, one year deep."
    },
    {
      "field": "segments",
      "type": "[{key, label, v}] | null",
      "note": "Present for breakdown cards. Must sum to `value`."
    },
    {
      "field": "rows",
      "type": "[{...}] | null",
      "note": "Present for list cards, with `truncated` when capped."
    },
    {
      "field": "period",
      "type": "{from, to, grain}",
      "note": "Exactly the window that produced `value`. Echoed back so the UI can prove what it is showing."
    },
    {
      "field": "asOf",
      "type": "timestamp",
      "note": "When the reading was computed. Drives the stale check."
    },
    {
      "field": "sources",
      "type": "[stream keys]",
      "note": "Which of the 16 streams fed this reading. Makes a wrong number traceable in one step."
    },
    {
      "field": "checks",
      "type": "[{invariant, passed}]",
      "note": "Which invariants were asserted on this reading and whether they held."
    }
  ],
  "invariants": [
    {
      "key": "balanced_books",
      "kind": "ledger",
      "rule": "Sum of debits equals sum of credits for the tenant, for any period.",
      "note": "If this fails, nothing downstream is trustworthy. Block the dashboard and raise."
    },
    {
      "key": "accounting_equation",
      "kind": "ledger",
      "rule": "Total assets equals total liabilities plus equity.",
      "note": "Catches a posting that hit only one side of the books."
    },
    {
      "key": "revenue_ties_to_ledger",
      "kind": "ledger",
      "rule": "Revenue from sales.headers equals the credit movement on revenue accounts for the same period.",
      "note": "The single most common cause of a wrong revenue card: the sales table and the ledger drifting apart."
    },
    {
      "key": "cogs_ties_to_ledger",
      "kind": "ledger",
      "rule": "COGS from sales.lines equals the debit movement on COGS accounts for the same period.",
      "note": "Catches sales posted without a cost layer — the reason margin cards go silly."
    },
    {
      "key": "gross_profit_identity",
      "kind": "internal",
      "rule": "Gross Profit equals Revenue minus COGS.",
      "note": "Pure arithmetic. Never allowed to drift."
    },
    {
      "key": "net_profit_identity",
      "kind": "internal",
      "rule": "Net Profit equals Gross Profit minus Total Expenses.",
      "note": "Pure arithmetic."
    },
    {
      "key": "liquidity_identity",
      "kind": "internal",
      "rule": "Total Liquidity equals cash in hand plus the sum of every bank balance.",
      "note": "Also proves Balance in Each Account sums to the headline."
    },
    {
      "key": "receivables_control",
      "kind": "ledger",
      "rule": "Receivables equals the sum of positive customer balances, and equals the AR control account.",
      "note": "Three sources must agree: party ledger, control account, card."
    },
    {
      "key": "payables_control",
      "kind": "ledger",
      "rule": "Payables equals the sum of positive supplier balances, and equals the AP control account.",
      "note": "Same three-way agreement on the buying side."
    },
    {
      "key": "stock_value_control",
      "kind": "ledger",
      "rule": "Stock Value from stock.positions equals the inventory control account balance.",
      "note": "Catches stock moved without a valuation posting."
    },
    {
      "key": "tax_control",
      "kind": "ledger",
      "rule": "Tax collected minus tax paid equals the net tax liability account.",
      "note": "Stops a filing built on a number that was never in the books."
    },
    {
      "key": "aging_sums_to_total",
      "kind": "shape",
      "rule": "Every aging breakdown's buckets sum to its headline total.",
      "note": "Applies to receivables, payables and udhaar aging."
    },
    {
      "key": "breakdown_sums_to_parent",
      "kind": "shape",
      "rule": "Any breakdown card's segments sum to the stat card it splits, within rounding tolerance.",
      "note": "Generic and cheap. Catches a filter applied to one card and not the other."
    },
    {
      "key": "trend_endpoint_matches_stat",
      "kind": "shape",
      "rule": "The last point of a trend series equals the stat card for the same period end.",
      "note": "Generic. Catches a trend built on a different date boundary than its headline."
    },
    {
      "key": "list_total_matches_stat",
      "kind": "shape",
      "rule": "A ranked list's rows sum to the stat they rank, when the list is complete.",
      "note": "Where the list is truncated, the card must say so rather than imply a total."
    },
    {
      "key": "no_silent_null",
      "kind": "shape",
      "rule": "No registered card may return null, undefined, or a bare zero without a status.",
      "note": "This is the rule that turns a blank card into a legible one."
    }
  ],
