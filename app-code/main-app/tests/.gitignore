# FinalTester — generated artifacts
#
# Everything here is produced by a run and can be regenerated:
#   reports/expected.json        php Scripts/expected.php
#   reports/summary.json         php Scripts/report.php
#   reports/junit.xml            written by PHPUnit during a run
#   reports/route-coverage.json  written by FullRouteSweepTest
#
# The test COPIES are also generated (Scripts/sync.php rebuilds them from
# Tester/tests on every run), so they are not tracked either. The source of
# truth for tests remains Tester/tests/ — commit changes there.

tests/*
!tests/Unit/
tests/Unit/*
!tests/Unit/Reckoner/
!tests/Feature/
tests/Feature/*
!tests/Feature/Reckoner/
!tests/Feature/Module/
reports/*.json
reports/*.xml
reports/coverage/
logs/*.log
dashboard/node_modules/
.phpunit.cache/
VerificationCenter/
!reports/.gitkeep
!logs/.gitkeep

# Exception: these two are FinalTester-owned source, not synced copies.
!tests/Routes/
!tests/Routes/FullRouteSweepTest.php
!tests/tests/Unit/Reckoner/
# NOTE: tests/tests/Feature/Reckoner/ is un-ignored above via the
# tests/Feature/ + tests/Feature/* + !tests/Feature/Reckoner/ block
# (paths there are written relative to this file's own directory, i.e.
# relative to tests/, so "tests/Feature/..." here means the real repo
# path tests/tests/Feature/...). A bare "!tests/tests/Feature/Reckoner/"
# rule does NOT work on its own — git cannot re-include a path whose
# parent directory (tests/tests/Feature/) is still excluded by an
# earlier tests/* rule, no matter how specific the later "!" is.

