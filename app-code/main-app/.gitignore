vendor/
node_modules/
.env
.env.backup
.env.production
# Prepared environment files (contain live secrets — copy to .env, never commit)
deploy/env/*.env
*.log
.DS_Store
Thumbs.db

# Ignore extracted builds
AMD_POS_Ultimate_v1.0/
AMD_POS_Ultimate_v1.0.zip

*.vyp
*.vyb
temp_vyb_inspect/
inspect.zip

release_hosting_VenQore_*.zip

# Scratch files and test dashboard logs
/scratch/
/Tester/dashboard/

# Destructive maintenance and security scripts (never commit or ship)
safe.env
truncate_tables.php
clean_db.php
wipe_test_data.php
fix_admin_passcode.php

# Ignore update directories and zip packages (v4+)
AMD_POS_Update_*/
AMD_POS_Update_v*.zip
*.exe

# L001: prevent future full-codebase duplicate snapshots from being committed.
# The canonical working copy is the repository root. Point-in-time copies like
# these confuse "which file is real" and pollute test discovery — keep them out
# of version control. (The existing tracked VenQore_Local/ and
# _VERIFICATION_BASELINE_*/ dirs should be removed in a dedicated cleanup commit.)
/VenQore_Local/
/_VERIFICATION_BASELINE_*/
/AMD_POS_Update_v*/
php_files_in_zip.txt
zip_contents.txt

/public/build


# Session-2 hygiene (2026-07-03): never ship editor/backup artifacts
*.bak
*.bak.*
*.backup-*
resources/js/Pages/**/*.backup*.jsx

# AI agent / IDE artifacts (session 3+4, 2026-07-04)
.claude/
3D/
Tester/dashboard/last-results.json

# Planning docs — tracked separately, not in repo
VenQore_Bootstrap_Master_Plan.md
VenQore_Launch_Readiness_Plan.docx

# Build & test artifacts (2026-08-04)
.phpunit.result.cache
bootstrap/ssr/
Tester/VerificationCenter/runs/*
