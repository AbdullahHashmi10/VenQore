{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run theme:build && node scratch/audit_ziggy_routes.cjs && vite build && vite build --ssr",
        "dev": "npm run theme:build && vite",
        "ssr": "php artisan inertia:start-ssr",
        "audit:routes": "node scratch/audit_route_params.cjs",
        "theme:build": "node resources/js/theme/build/generate.js",
        "theme:check": "node resources/js/theme/build/generate.js --check",
        "theme:verify": "node resources/js/theme/build/verify-parity.js",
        "theme:codemod": "node resources/js/theme/build/codemod.js",
        "test": "vitest run resources/js/tests",
        "test:watch": "vitest resources/js/tests",
        "test:coverage": "vitest run --coverage resources/js/tests"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/typography": "^0.5.19",
        "@vitejs/plugin-react": "^4.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "adm-zip": "^0.5.16",
        "archiver": "^7.0.1",
        "autoprefixer": "^10.4.16",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^3.4.17",
        "vite": "^7.0.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@number-flow/react": "^0.6.2",
        "@visx/curve": "^4.0.0",
        "@visx/event": "^4.0.0",
        "@visx/gradient": "^4.0.0",
        "@visx/grid": "^4.0.0",
        "@visx/group": "^4.0.0",
        "@visx/pattern": "^4.0.0",
        "@visx/responsive": "^4.0.0",
        "@visx/scale": "^4.0.0",
        "@visx/shape": "^4.0.0",
        "@visx/zoom": "^4.0.0",
        "clsx": "^2.1.1",
        "d3-array": "^3.2.4",
        "d3-shape": "^3.2.0",
        "dexie": "^4.2.1",
        "driver.js": "^1.4.0",
        "laravel-echo": "^2.3.4",
        "lucide-react": "^0.562.0",
        "marked": "^18.0.7",
        "motion": "^13.1.0",
        "pusher-js": "^8.5.0",
        "react-grid-layout": "^2.2.3",
        "react-use": "^17.6.0",
        "react-use-measure": "^2.1.7",
        "recharts": "^3.6.0",
        "sweetalert2": "^11.26.17",
        "tailwind-merge": "^3.6.0",
        "use-debounce": "^10.1.0"
    },
    "name": "venqore-pos"
}
