{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run fonts:check && npm run ds:check && npm run theme:sync && node scratch/audit_ziggy_routes.cjs && vite build && vite build --ssr",
        "dev": "npm run theme:sync && vite",
        "ssr": "php artisan inertia:start-ssr",
        "audit:routes": "node scratch/audit_route_params.cjs",
        "theme:sync": "npm run theme:from-v6 && npm run theme:build",
        "theme:from-v6": "node resources/js/theme/build/from-v6-tokens.js",
        "theme:build": "node resources/js/theme/build/generate.js",
        "theme:check": "node resources/js/theme/build/generate.js --check",
        "theme:verify": "node resources/js/theme/build/verify-parity.js",
        "theme:codemod": "node resources/js/theme/build/codemod.js",
        "design:check": "bash scripts/design-check.sh",
        "design:baseline": "bash scripts/design-check.sh --baseline",
        "fonts:vendor": "node scripts/fonts-vendor.mjs",
        "fonts:check": "node scripts/fonts-vendor.mjs --check",
        "ds:contract": "node scripts/ds-adherence.mjs",
        "ds:check": "node scripts/ds-adherence.mjs --check && oxlint -c resources/js/Components/ds/_adherence.oxlintrc.json resources/js",
        "lint": "oxlint resources/js",
        "lint:fix": "oxlint --fix resources/js",
        "verify": "npm run theme:check && npm run design:check",
        "test": "vitest run resources/js/tests",
        "test:watch": "vitest resources/js/tests",
        "test:coverage": "vitest run --coverage resources/js/tests",
        "check:doc-classes": "node scripts/check-document-classes.mjs"
    },
    "devDependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/figtree": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/typography": "^0.5.19",
        "@vitejs/plugin-react": "^4.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "adm-zip": "^0.5.16",
        "archiver": "^7.0.1",
        "autoprefixer": "^10.4.16",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsrepo": "^3.8.1",
        "laravel-vite-plugin": "^2.0.0",
        "oxlint": "^1.79.0",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "shadcn": "^4.18.0",
        "tailwindcss": "^3.4.17",
        "vite": "^7.0.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "@heroicons/react": "^2.2.0",
        "@number-flow/react": "^0.6.2",
        "@visx/curve": "^4.0.0",
        "@visx/event": "^4.0.0",
        "@visx/gradient": "^4.0.0",
        "@visx/grid": "^4.0.0",
        "@visx/group": "^4.0.0",
        "@visx/pattern": "^4.0.0",
        "@visx/responsive": "^4.0.0",
        "@visx/scale": "^4.0.0",
        "@visx/shape": "^4.0.0",
        "@visx/zoom": "^4.0.0",
        "clsx": "^2.1.1",
        "d3-array": "^3.2.4",
        "d3-shape": "^3.2.0",
        "dexie": "^4.2.1",
        "driver.js": "^1.4.0",
        "gsap": "^3.15.0",
        "laravel-echo": "^2.3.4",
        "lucide-react": "^0.562.0",
        "marked": "^18.0.7",
        "motion": "^12.43.0",
        "pusher-js": "^8.5.0",
        "qrcode.react": "^4.2.0",
        "react-grid-layout": "^2.2.3",
        "react-use": "^17.6.0",
        "react-use-measure": "^2.1.7",
        "recharts": "^3.6.0",
        "sweetalert2": "^11.26.17",
        "tailwind-merge": "^3.6.0",
        "three": "^0.185.1",
        "use-debounce": "^10.1.0"
    },
    "name": "venqore-pos"
}
