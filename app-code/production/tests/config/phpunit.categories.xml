<!--
  FinalTester/config/phpunit.categories.xml — CATEGORY LANES
  ==========================================================

  These suites OVERLAP ON PURPOSE. A single test can be both "Financial" and
  "Ledger"; a guardrail can also be "Security". That is useful for targeted
  runs and for the dashboard's per-area breakdown.

  BECAUSE THEY OVERLAP, THIS FILE MUST ALWAYS BE RUN WITH AN EXPLICIT
  testsuite flag. Never run it bare. The BAT launchers in FinalTester always
  pass one; see README.md for the exact command lines.

  A bare run would execute shared tests several times and inflate every count.
  The canonical, each-test-exactly-once definition is FinalTester/phpunit.xml.

  Paths are relative to this file, hence the ../tests prefix.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../bootstrap.php"
         colors="true"
         stopOnFailure="false"
         cacheDirectory="../.phpunit.cache"
>
    <extensions>
        <bootstrap class="Tests\Support\RunLedger\RunLedgerExtension"/>
        <bootstrap class="Tests\Support\Live\LiveMetricsExtension"/>
    </extensions>

    <testsuites>

