{
  "name": "venqore-station",
  "productName": "VenQore Station",
  "version": "3.1.4",
  "description": "VenQore Station — hardware bridge for the VenQore cloud POS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/*.test.cjs\"",
    "icons": "node tools/make-icons.js",
    "build:win": "npm run icons && electron-builder --win --x64",
    "build:portable": "npm run icons && electron-builder --win portable --x64"
  },
  "author": "VenQore Group",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.venqore.station",
    "productName": "VenQore Station",
    "copyright": "Copyright © 2026 VenQore Group",
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.venqore.com/station/",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "shell-preload.js",
      "display-preload.js",
      "print-payload.js",
      "shell.html",
      "shell.css",
      "shell-renderer.js",
      "customer-display.html",
      "customer-display.js",
      "lib/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@serialport/**/*",
      "node_modules/serialport/**/*"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "VenQore"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VenQore Station",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "VenQore-Station-Setup-${version}.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "VenQore-Station-${version}-Portable.${ext}"
    },
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    }
  }
}
